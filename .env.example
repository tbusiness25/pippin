# ---- Pippin configuration ---------------------------------------------------
# Easiest: run `./scripts/setup.sh` and it writes this file for you.
# Display name (optional) — call your copy whatever you like.
# APP_NAME=Pippin

# ---- Secrets (required). Generate each with: openssl rand -hex 32 --------------
JWT_SECRET=
DATA_KEY=                            # encrypts chats/transcripts at rest. BACK IT UP — no recovery without it.
DB_PASSWORD=
# Optional but recommended: asked for on the first-run screen, so nobody else can claim a fresh install.
# SETUP_CODE=

# ---- AI model (pick ONE provider) ---------------------------------------------
# ollama      — local, private, free. Install Ollama, then `ollama pull qwen3:8b` (or any instruct model)
# openai      — ChatGPT models, needs an API key from platform.openai.com
# anthropic   — Claude models, needs an API key from console.anthropic.com
# openrouter  — hundreds of models with one key (openrouter.ai)
# gemini      — Google Gemini, key from aistudio.google.com
# custom      — any other OpenAI-compatible server (llama.cpp, LM Studio, vLLM, LocalAI…): set AI_BASE_URL
# With a cloud provider your coach conversations go to that company. The app tells you so.
AI_PROVIDER=ollama
AI_MODEL=qwen3:8b
# AI_API_KEY=
# AI_BASE_URL=                       # override the provider's address, e.g. http://192.168.1.20:11434/v1
# Ollama on the same machine is reached from Docker as host.docker.internal (the default).
# Running WITHOUT Docker? Set AI_BASE_URL=http://localhost:11434/v1

# Thinking models (Qwen3, DeepSeek-R1…) on Ollama: stops answers ending up empty
COACH_REASONING_EFFORT=none
OPENAI_REASONING_EFFORT=none

# ---- Basics -------------------------------------------------------------------
TZ_DEFAULT=Europe/London
APP_HOST_PORT=8910
# APP_BIND=127.0.0.1                 # 0.0.0.0 to reach it from your LAN without a reverse proxy
SW_VERSION=1                         # bump after editing public/ so installed apps update
COACH_RETENTION_DAYS=60              # coach conversations are deleted after this many days
# CRISIS_RESOURCES_JSON=[{"name":"988 Lifeline","detail":"Call or text 988","href":"tel:988"}]   # outside the UK

# ---- Database -----------------------------------------------------------------
DB_NAME=pippin
DB_USER=pippin
DB_HOST_PORT=5446                    # Docker only: Postgres published on 127.0.0.1
# Running WITHOUT Docker:
# DB_HOST=localhost
# DB_PORT=5432

# ---- Advanced: different models for different jobs (each overrides AI_*) --------
# COACH_BASE_URL=  COACH_MODEL=  COACH_API_KEY=          # the private coach + chat
# OPENAI_BASE_URL= OPENAI_MODEL= OPENAI_API_KEY=         # "plan my day" (BRAIN=openai)
# STORY_BASE_URL=  STORY_MODEL=  STORY_API_KEY=          # a small fast model for the pet's adventure stories
# STORY_REASONING_EFFORT=none

# ---- Your agent (optional — see docs/AGENT.md) ---------------------------------
# Connect an agent with tools (email, calendar, bank, wearables…) for "plan my day" and goals it ticks for you.
# BRAIN=hermes
# HERMES_API_URL=http://hermes:8642/v1
# HERMES_API_KEY=
# HERMES_MODEL=hermes-agent
# HERMES_CONTEXT_HINT=Use your google-workspace skill for Gmail and Calendar.
# Any other agent with an OpenAI-compatible API:
# BRAIN=agent
# AGENT_API_URL=http://my-agent:8000/v1
# AGENT_API_KEY=
# AGENT_MODEL=agent
# Extra sources the planner should look at, and how often linked goals are checked:
# AGENT_SOURCES=Firefly III (bank balances, bills due), Open Wearables (sleep, steps)
# AGENT_CHECK_EVERY_MIN=60

# Join an existing Docker network (e.g. your reverse proxy's or Ollama's)
# EXTRA_NETWORK=my_network
# EXTRA_NETWORK_EXTERNAL=true

# ---- Optional features ----------------------------------------------------------
# Everyday chat may search the web (search terms leave your network; the coach never does)
# CHAT_WEB=true
# SEARXNG_URL=http://searxng:8080

# Local voice (OpenAI-compatible): Whisper speech-to-text, Kokoro/Piper text-to-speech
# WHISPER_URL=http://host.docker.internal:8787/v1
# TTS_URL=http://host.docker.internal:8880/v1
# TTS_VOICE=bf_emma

# An Obsidian folder for notes you approve (People/, Journal/, Weekly/, Plans.md)
# VAULT_HOST_DIR=/path/to/vault/Pippin
# VAULT_DIR=/vault

# A folder of transcribed voice notes to sort (frontmatter recording_id/date, "## Transcript", ![[audio/…]])
# VOICE_NOTES_HOST_DIR=/path/to/vault/Voice Notes
# VOICE_NOTES_DIR=/voice-notes
# AUDIO_STORE=/data/audio

# Live WhatsApp link — contact metadata only, unofficial library (docs/KNOWN_ISSUES.md B8)
# COMPOSE_PROFILES=whatsapp
# WHATSAPP_SIDECAR_URL=http://whatsapp:3000
# WHATSAPP_SIDECAR_SECRET=           # openssl rand -hex 24
