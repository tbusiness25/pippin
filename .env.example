# ============================================================================
# Pippin configuration. Copy this to .env (scripts/setup.sh does it for you).
# Lines starting with # are off. Remove the # to turn a setting on.
# Every secret below is blank here. Never commit a .env with real values.
# ============================================================================

# ---- 1. Secrets (required) ----------------------------------------------------
# Generate each one with:  openssl rand -hex 32
JWT_SECRET=                          # signs sign-in sessions. Required: the app stops without it.
DATA_KEY=                            # 64 hex characters. Encrypts coach and chat messages and other sensitive text.
                                     # Required: the app stops without it. BACK IT UP, separately from your database.
                                     # There is no recovery without it.
DB_PASSWORD=                         # Postgres password (Docker). Required with Docker.
# SETUP_CODE=                        # asked for on the first-run screen, so a stranger can't claim a new install.
                                     # Strongly recommended if the app is reachable from anywhere but your own home.

# ---- 2. Basics ----------------------------------------------------------------
TZ_DEFAULT=Europe/London             # time zone for "today", nudges, time windows and the morning briefing
SW_VERSION=1                         # bump after editing public/ so installed apps update
# APP_NAME=Pippin                    # the name on screen and on the home-screen icon (30 characters at most)
# HOST_APP_NAME=Pippin               # name for per-person installs (see HOST_USERS). Defaults to APP_NAME.
# APP_VERSION=                       # overrides the version shown in the app (defaults to package.json)
# PORT=8080                          # port for `npm start` without Docker. Docker maps 8080 in the container.
APP_HOST_PORT=8910                   # Docker: port on the host
# APP_BIND=127.0.0.1                 # 0.0.0.0 to reach it from your LAN without a reverse proxy.
                                     # Put HTTPS in front before exposing it beyond your network.
# APP_UID=1000
# APP_GID=1000                       # user the app runs as in Docker. Files it writes (such as a notes folder) belong to them.
# CONTAINER_PREFIX=pippin            # prefix for container names, so two copies can run side by side
# BASIC_AUTH_USER=
# BASIC_AUTH_PASS=                   # optional username and password for the whole site (for example, a shared demo).
                                     # The health check and /hooks stay open.
# COMPOSE_PROFILES=fitness           # optional containers to start: fitness, whatsapp (combine with a comma)

# ---- 3. Database ----------------------------------------------------------------
DB_NAME=pippin
DB_USER=pippin
DB_HOST_PORT=5446                    # Docker: Postgres published on 127.0.0.1 only
# PGDATA_VOLUME=pippin-pgdata        # Docker: name of the database volume
# WADATA_VOLUME=pippin-wa-data       # Docker: name of the WhatsApp link's volume
# Running WITHOUT Docker (see README):
# DB_HOST=localhost
# DB_PORT=5432

# ---- 4. AI for the adult coach and everyday chat -------------------------------
# Pick ONE provider. The setup script asks you.
# ollama      local, private. Install Ollama, then `ollama pull qwen3:8b` (or any instruct model)
# openai      needs an API key from platform.openai.com
# anthropic   needs an API key from console.anthropic.com
# openrouter  one key for many models (openrouter.ai)
# gemini      needs a key from aistudio.google.com
# custom      any other OpenAI-compatible server (llama.cpp, LM Studio, vLLM, LocalAI): set AI_BASE_URL
# With a cloud provider, the coach's conversations go to that company. The app says so.
AI_PROVIDER=ollama
AI_MODEL=qwen3:8b
# AI_API_KEY=
# AI_BASE_URL=                       # e.g. http://my-gpu-box.local:11434/v1. Ollama on this machine from Docker is host.docker.internal (the default).
COACH_REASONING_EFFORT=none          # thinking models (Qwen3, DeepSeek-R1...) on Ollama: stops answers ending up empty
OPENAI_REASONING_EFFORT=none
# COACH_TIMEOUT_MS=120000            # how long to wait for the coach's model
COACH_RETENTION_DAYS=60              # coach conversations are deleted after this many days. Use 1 or more.
                                     # Do NOT set 0: at the next purge that deletes every conversation.
# Advanced: a different model for each job. Each one overrides AI_* for that job only.
# COACH_BASE_URL=  COACH_MODEL=  COACH_API_KEY=           # the coach and everyday chat
# OPENAI_BASE_URL= OPENAI_MODEL= OPENAI_API_KEY=          # the day planner (only with BRAIN=openai)
# STORY_BASE_URL=  STORY_MODEL=  STORY_API_KEY=           # a small, fast model for stories. Also the fallback for the
#                                                         # children's model and the morning briefing if those are unset.
# STORY_REASONING_EFFORT=none

# ---- 5. Support lines, search and alerts ----------------------------------------
# CRISIS_RESOURCES_JSON=[{"name":"Your local helpline","detail":"Call or text the number for your country","href":"https://example.org"}]   # the coach's crisis screen. Defaults are UK.
# SOBER_HELPLINES_JSON={}            # extra or replacement helplines for the sobriety tracker (JSON). Defaults are UK.
# CHAT_WEB=true                      # everyday chat may search the web. Search terms leave your network. The coach never searches.
# SEARXNG_URL=http://searxng:8080    # your SearXNG instance (needed for CHAT_WEB)
# ALERT_TELEGRAM_BOT_TOKEN=          # optional: child-safety alerts also go to a Telegram chat (they always go to parents' push)
# ALERT_TELEGRAM_CHAT_ID=

# ---- 6. Your agent (optional) ---------------------------------------------------
# An agent with tools (email, calendar, bank, wearables) for "plan my day" and for goals it can tick.
# The agent keeps its own passwords. Pippin only asks it questions. See docs/AGENT.md.
# BRAIN=hermes                       # hermes | agent | openai. Leave blank for no agent.
# HERMES_API_URL=http://hermes:8642/v1
# HERMES_API_KEY=
# HERMES_MODEL=hermes-agent
# HERMES_CONTEXT_HINT=Use your google-workspace skill for Gmail and Calendar.
# HERMES_TIMEOUT_MS=300000
# AGENT_API_URL=http://my-agent:8000/v1   # for BRAIN=agent: any OpenAI-compatible agent
# AGENT_API_KEY=
# AGENT_MODEL=agent
# AGENT_CONTEXT_HINT=
# AGENT_DEFAULT_LABEL=Hermes         # what the owner's agent is called in Talk
# AGENT_DEFAULT_KIND=agent           # agent | hermes (hermes keeps its own sessions)
# AGENT_SOURCES=Firefly III (bank balances, bills due), Open Wearables (sleep, steps)   # what else "plan my day" may look at
# AGENT_CHECK_EVERY_MIN=60           # how often agent-linked goals are checked (15 at the least)
# AGENT_CHAT_TIMEOUT_MS=600000       # how long Talk waits for an agent to reply
# Extra agents for other adults. Each name is one profile; a person's agent is set in the database (users.brain).
# AGENT_PROFILES=partner
# AGENT_PARTNER_URL=http://their-agent:8642/v1
# AGENT_PARTNER_KEY=
# AGENT_PARTNER_MODEL=hermes
# AGENT_PARTNER_LABEL=Hermes
# AGENT_PARTNER_KIND=hermes          # hermes | agent
# AGENT_PARTNER_CONTEXT_HINT=

# ---- 7. Voice, notes and files --------------------------------------------------
# Local voice on OpenAI-compatible servers. Nothing goes to a cloud service unless you point these at one.
# WHISPER_URL=http://host.docker.internal:8787/v1     # speech to text
# WHISPER_MODEL=whisper-1
# TTS_URL=http://host.docker.internal:8880/v1         # text to speech (Kokoro, Piper...)
# TTS_MODEL=kokoro
# TTS_VOICE=bf_emma
# AUDIO_STORE=/data/audio            # backup copies of important audio
# VAULT_HOST_DIR=/path/to/your/notes/Pippin   # Docker: an Obsidian folder for notes you approve
# VAULT_DIR=/vault                   # the same folder, inside the container
# VOICE_NOTES_HOST_DIR=/path/to/voice-notes   # Docker: a folder of transcribed recordings to sort
# VOICE_NOTES_DIR=/voice-notes       # the same folder, inside the container
# VOICE_NOTES_MOUNT=ro               # ro (default) or rw. Writable lets notes be filed into folders.
# VOICE_FILE_INTO_FOLDERS=true       # file each note into Kids/, Memories/, Journal/, Reminders/, Work/, Other/
# VOICE_KEEP_ALL_AUDIO=true          # back up every recording's audio, not just the kids' and memories
# READS_DIR=/data/reads              # Markdown articles for Explore → Reads (an audio file with the same name plays with it)

# ---- 8. Fitness add-on (optional) -----------------------------------------------
# Runs SparkyFitness (food diary, meal plans, workouts, Garmin) next to Pippin. Each person gets their own account.
# COMPOSE_PROFILES=fitness
# SPARKY_URL=http://sparky-server:3010
# SPARKY_DB_PASSWORD=                # openssl rand -hex 24
# SPARKY_APP_DB_PASSWORD=            # openssl rand -hex 24
# SPARKY_ENCRYPTION_KEY=             # openssl rand -hex 32. Encrypts the Garmin tokens.
# SPARKY_AUTH_SECRET=                # openssl rand -hex 32
# SPARKY_VERSION=latest
# SPARKY_DATA_DIR=./data/sparky

# ---- 9. WhatsApp link (optional, unofficial) -------------------------------------
# Reads who messaged whom and when, never the message text. Uses an unofficial library: see docs/KNOWN_ISSUES.md.
# COMPOSE_PROFILES=whatsapp
# WHATSAPP_SIDECAR_URL=http://whatsapp:3000
# WHATSAPP_SIDECAR_SECRET=           # openssl rand -hex 24

# ---- 10. Household ---------------------------------------------------------------
# Several people on one server. The PIN is always checked. A host never signs anyone in by itself.
# HOST_USERS=app.example.org=alex:#6f9f5c,kids.example.org=sam:#ff8838     # host=slug-or-name[:#colour]
# EXPLORE_LINKS=[{"emoji":"🔗","name":"Something useful","sub":"Opens in a new tab","url":"https://example.org"}]   # extra Explore tiles

# ---- 11. Children's accounts and features -----------------------------------------
# A child has their own app: no coach, no web search, no agent. Their AI features use the children's model below.
# That model has no tools and no web access. Run it locally. See docs/SAFETY.md (children's section).
# KIDS_LLM_URL=http://host.docker.internal:11434/v1   # OpenAI-compatible endpoint for Buddy, Book Chat and the safety check.
                                     # Unset: the app uses STORY_BASE_URL instead.
# KIDS_LLM_MODEL=
# KIDS_LLM_API_KEY=
# KIDS_LLM_REASONING_EFFORT=none
# KIDS_LLM_ALLOW_CLOUD=false         # the children's model may only call hosts on your network. Refused otherwise.
                                     # true lifts that block, and a warning is logged at start-up. Not recommended.
# KIDS_CLASSIFY_MODEL=               # a small, fast model for the "is this safe?" check (recommended)
# KIDS_DATA_DIR=/data/kids           # children's audio, book covers, catalogues, room.json, today.json
# KIDS_BUDDY_RETENTION_DAYS=90       # Buddy chat messages are deleted after this many days. 0 keeps them.
# KIDS_BOOK_CHAT_RETENTION_DAYS=0    # Book Chat voice recordings are deleted after this many days. 0 (default) keeps them until removed.
# CHILD_PURGE_DAYS=30                # a removed child's data is purged for good after this many days (whole days, 1 or more)
# CHILD_PURGE_DRY_RUN=false          # true logs what the purge would delete, and deletes nothing
# KIDS_BUDDY_LIMIT_ENABLED=false     # true: a daily time limit for Buddy
# KIDS_BUDDY_DAILY_MINUTES=30        # used when the limit is on
# KIDS_BUDDY_SESSION_MINUTES=10      # used when the limit is on
# KIDS_TTS_MODEL=kokoro              # Buddy can read its replies aloud when KIDS_TTS_VOICE is set (and TTS_URL)
# KIDS_TTS_VOICE=
# KIDS_ALLOWANCE_PENCE=500           # default weekly pocket money, in pence (500 = £5)
# KIDS_STUDY_REWARD_PENCE=50         # pocket money for finishing a Learn module, once
# KIDS_BOOK_STARS=3                  # stars for a child's first Book Chat on each book (0 = off)
# BOOKS_CATALOGUE=                   # the book list (JSON). Default: KIDS_DATA_DIR/books/books-catalogue.json
# LIBRARY_DIR=/data/library          # audio for the listening library and stories
# KIDS_LEARN_DRAFT_WEBHOOK=          # your workflow that drafts Learn modules. A parent approves each one before a child sees it.
# KIDS_VOICE_NOTES=false             # false stops Book Chat notes being written to the voice-notes folder (on by default when VOICE_NOTES_DIR is set)
# KIDS_VOICE_NOTES_SUBDIR=Kids       # folder for Book Chat voice notes inside the voice-notes folder
# KIDS_VOICE_NOTES_INDEX=_Kids Memories.md
# KIDS_ROOM_CONTROLS=                # the few Home Assistant controls a child may use (JSON). Or put room.json in KIDS_DATA_DIR.
# HA_URL=http://homeassistant.local:8123
# HA_TOKEN=                          # a Home Assistant long-lived token. Stays on the server.
# HOOKS_TOKEN=                       # openssl rand -hex 24. Your automations (n8n, story workers) call /hooks/<slug>/… with it.
                                     # Refused if the request came through a proxy.

# ---- 12. Yoto ("My Yoto", optional) -----------------------------------------------
# YOTO_CLIENT_ID=                    # your own Yoto app's client id (register one with Yoto)
# YOTO_REDIRECT=https://your-host.example/api/family/yoto/callback   # must be registered in Yoto's developer dashboard

# ---- 13. Morning briefing and weather (optional, per adult) -----------------------
# BRIEFING_FOR=alex,sam              # slugs of the adults who get a briefing. Or * for every adult.
# BRIEF_HOUR=7                       # hour it is written, in each person's time zone
# BRIEF_BASE_URL=                    # OpenAI-compatible endpoint for the briefing. Unset: uses STORY_BASE_URL.
# BRIEF_MODEL=
# BRIEF_API_KEY=
# BRIEF_REASONING_EFFORT=none
# BRIEF_TIMEOUT_MS=240000
# BRIEF_LAT=                         # weather from Open-Meteo (no key). Set both or neither.
# BRIEF_LON=

# ---- 14. Web Push (nudges) ---------------------------------------------------------
# Leave these blank. The app makes a key pair the first time and keeps it in its database.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.org   # a contact address the push service may use. Default mailto:admin@localhost

# ---- 15. Public demo only ------------------------------------------------------------
# DEMO_MODE=false                    # true: a shared, made-up family that resets nightly. Never on a real family's server.
# DEMO_USERS=sam,alex,pip            # visitors are signed in as the first of these
# DEMO_RESET_HOUR=4                  # hour (0–23) the demo is wiped and re-seeded
# DEMO_GUEST_HOSTS=                  # host=landing-page pairs for guest hosts

# ---- 16. Docker network (optional) -------------------------------------------------
# EXTRA_NETWORK=my_network           # join an existing Docker network, such as your reverse proxy's
# EXTRA_NETWORK_EXTERNAL=true        # set true when that network already exists

# ---- 17. Internal and older names (leave these alone unless you know why) ----------
# APP_INTERNAL_URL=http://app:8080/internal   # WhatsApp sidecar → app. Set by Docker Compose.
# FINCH_INTERNAL_URL=                # older name for APP_INTERNAL_URL
# FINCH_DATA_KEY=                    # older name for DATA_KEY (DATA_KEY wins if both are set)
# FINCH_VAULT_DIR=                   # older name for VAULT_DIR
# PG_CONTAINER=pippin-postgres       # scripts/import-history.py only

