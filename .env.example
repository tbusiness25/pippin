# ---- Pippin configuration -------------------------------------------
# Display name (optional) — call your copy whatever you like.
# APP_NAME=Pippin
# Database (the bundled Postgres container)
DB_NAME=pippin
DB_USER=pippin
DB_PASSWORD=change-me-to-something-long
DB_HOST_PORT=5446
APP_HOST_PORT=8910
# APP_BIND=127.0.0.1                # 0.0.0.0 to reach it from your LAN without a proxy

# Session signing secret: `openssl rand -hex 32`
JWT_SECRET=
# Optional: required on the first-run screen, so nobody else can claim a fresh install.
# SETUP_CODE=
TZ_DEFAULT=Europe/London
SW_VERSION=1

# ---- Coach brain: pick ONE -------------------------------------------------
# A) Hermes Agent (reads your calendar/email/tasks with its own tools).
#    In Hermes: API_SERVER_ENABLED=true and set API_SERVER_KEY.
# BRAIN=hermes
# HERMES_API_URL=http://hermes:8642/v1
# HERMES_API_KEY=
# HERMES_MODEL=hermes-agent

# B) Any OpenAI-compatible model (Ollama, llama.cpp, OpenAI, OpenRouter…).
# BRAIN=openai
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=qwen3.5:4b
# OPENAI_REASONING_EFFORT=none     # for Qwen3-style thinking models

# Optional: a small fast model just for adventure stories (else the brain or built-in templates).
# STORY_BASE_URL=http://localhost:11434/v1
# STORY_MODEL=qwen3.5:4b
# STORY_REASONING_EFFORT=none

# Optional: also join an existing Docker network (e.g. to reach a Hermes container by name).
# EXTRA_NETWORK=my_network
# EXTRA_NETWORK_EXTERNAL=true
# Optional extra instruction for Hermes' planner (e.g. which skill reads your calendar/email)
# HERMES_CONTEXT_HINT=Use your google-workspace skill for Gmail and Calendar.

# ---- Private ADHD coach ----------------------------------------------------
# The coach is the app's own engine: its only tools act on the app's data. Point it at an
# OpenAI-compatible endpoint you control — ideally LOCAL (Ollama/llama.cpp). The app warns if it isn't.
DATA_KEY=                            # openssl rand -hex 32 — encrypts chats/transcripts at rest. BACK IT UP.
COACH_BASE_URL=http://localhost:11434/v1
COACH_MODEL=qwen3.5:9b
COACH_REASONING_EFFORT=none          # for Qwen3-style thinking models
COACH_RETENTION_DAYS=60              # coach transcripts are deleted after this
# CRISIS_RESOURCES_JSON=[{"name":"988 Lifeline","detail":"Call or text 988","href":"tel:988"}]   # non-UK

# Optional local voice (OpenAI-compatible): Whisper for speech-to-text, Kokoro/Piper for text-to-speech
# WHISPER_URL=http://host.docker.internal:8787/v1
# TTS_URL=http://host.docker.internal:8880/v1
# TTS_VOICE=bf_emma

# Optional Obsidian folder the app may write approved notes into (People/, Journal/, Weekly/, Plans.md)
# VAULT_HOST_DIR=/path/to/vault/Companion
# VAULT_DIR=/vault

# Optional live WhatsApp link (metadata only, unofficial library — see docs/KNOWN_ISSUES.md B8).
# Or import chat exports from the app instead.
# COMPOSE_PROFILES=whatsapp
# WHATSAPP_SIDECAR_URL=http://whatsapp:3000
# WHATSAPP_SIDECAR_SECRET=          # openssl rand -hex 24

# ---- Voice notes (optional) ----
# A folder of voice-note markdown files (frontmatter recording_id/date, "## Transcript", ![[audio/…]] links),
# e.g. an OpenPlaud → Obsidian export. The app reads it, sorts each new recording and keeps important audio.
# VOICE_NOTES_HOST_DIR=/path/to/vault/Voice Notes
# VOICE_NOTES_DIR=/voice-notes
# AUDIO_STORE=/data/audio

# ---- General chat ----
# CHAT_WEB=true sends search terms (and pages it reads) out to SearXNG/the web. The coach never does.
# CHAT_WEB=false
# SEARXNG_URL=http://searxng:8080
